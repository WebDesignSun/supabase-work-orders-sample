# Copy to .env and choose your own values. .env is git-ignored; never commit it.
# Everything here is for the LOCAL stack started with `supabase start`.

# Password the README's "Run it" step sets on the seeded demo users
# (seed.sql creates them without one).
DEMO_PASSWORD=choose-a-local-password

# Optional, for a deployed function: the origin allowed by CORS.
# Unset means "*" (safe here: the function authenticates by bearer token, not cookies).
# Set it with: supabase secrets set ALLOWED_ORIGIN=https://app.example.com
# ALLOWED_ORIGIN=https://app.example.com
